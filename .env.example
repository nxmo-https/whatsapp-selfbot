# Command prefix, e.g. "$" so commands look like $ping
PREFIX=$

# Max deleted messages to keep per chat for !snipe
SNIPE_CACHE_SIZE=1

# Optional: path to an existing Chromium-based browser (e.g. Edge) so Puppeteer
# doesn't download its own Chromium. Leave blank to use the bundled one.
# Windows example: EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Mac example:      EXECUTABLE_PATH=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge
# Linux example:     EXECUTABLE_PATH=/usr/bin/microsoft-edge
EXECUTABLE_PATH=
